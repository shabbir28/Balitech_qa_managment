# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bpo_qa_system
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Google Sheet Transfer QA Webhook
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_SHEET_SECRET=your_secret_key_here

# Vicidial Dialers (required to use any /api/dialer or /api/dialer-sales route)
PHARMACY_DIALER_URL=https://your-pharmacy-dialer.example.com/PATH/admin.php
PHARMACY_DIALER_USER=your_pharmacy_dialer_user
PHARMACY_DIALER_PASS=your_pharmacy_dialer_password

MEDICARE_DIALER_URL=https://your-medicare-dialer.example.com/PATH/admin.php
MEDICARE_DIALER_USER=your_medicare_dialer_user
MEDICARE_DIALER_PASS=your_medicare_dialer_password

DIALER_RECORDINGS_URL=http://your-recordings-host/RECORDINGS/MP3

# HRMS Sync (backend-only, never expose to frontend)
HRMS_SYNC_URL=https://hrms.balitech.org/api/sync_dialer_transfers.php
HRMS_SYNC_SECRET=your_hrms_sync_secret_here
